{
  "name": "job-vaccum-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=26.12.0 <27"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "npm run build && node --test tests/*.test.cjs",
    "test:e2e": "npm run build && playwright test",
    "build:backend": "node scripts/build-backend.mjs",
    "package:mac": "npm run build && npm run build:backend && electron-builder --mac --arm64",
    "package:dir": "npm run build && npm run build:backend && electron-builder --mac --arm64 --dir",
    "test:e2e:smoke": "npm run build && playwright test --grep @smoke"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "markdown-it": "14.3.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "description": "Job Vaccum M0 desktop foundation",
  "author": "Job Vaccum contributors",
  "main": "dist/electron/main/index.js"
}
